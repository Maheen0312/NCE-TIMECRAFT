rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isEmailAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (
          request.auth.token.email == 'admin@nce.edu' ||
          request.auth.token.email == 'maheenmohideen@gmail.com' ||
          request.auth.token.email == 'synedcdev@gmail.com' ||
          request.auth.token.email == 'admin@nce.ac.in' ||
          request.auth.token.email == 'hodcse@nce.ac.in' ||
          request.auth.token.email.matches('.*admin.*@.*') ||
          request.auth.token.email.matches('.*@nce\\.edu') ||
          request.auth.token.email.matches('.*@nce\\.ac\\.in')
        );
    }

    function isRoleAdmin() {
      return hasUserDoc() &&
        (
          getUserData().role == 'admin' ||
          getUserData().role == 'Admin' ||
          getUserData().role == 'ADMIN' ||
          getUserData().role == 'administrator' ||
          getUserData().role == 'Administrator'
        );
    }

    function isAdmin() {
      return isSignedIn() && (isEmailAdmin() || isRoleAdmin());
    }

    function isStaffRole() {
      return hasUserDoc() &&
        (
          getUserData().role == 'staff' ||
          getUserData().role == 'Staff' ||
          getUserData().role == 'STAFF' ||
          getUserData().role == 'faculty' ||
          getUserData().role == 'Faculty'
        );
    }

    function isStaff() {
      return isSignedIn() && (isAdmin() || isStaffRole());
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isEmailAdmin() || isRoleAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. User sessions & presence
    match /userSessions/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // 3. Staff directory
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && (request.auth.uid == staffId || (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid)));

      // Staff published personal timetable slices
      match /timetable/{timetableDocId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // 4. Subjects
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. Labs
    match /labs/{labId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 6. Rooms
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 7. Time Slots
    match /timeSlots/{slotId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 8. Special Sessions
    match /specialSessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 9. Scheduling Rules
    match /schedulingRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 10. Timetables
    match /timetables/{timetableId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 11. Timetable Versions
    match /timetableVersions/{versionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 12. Departments & Classes
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 13. System Settings
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 14. Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 15. Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
